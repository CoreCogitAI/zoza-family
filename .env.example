# Test-only wallets on Ethereum Sepolia. Never put real money in these.
DEPLOYER_KEY=   # deploys, and runs the test faucet (holds test USDC and a little ETH)
RELAYER_KEY=    # pays gas for families' signed batches
KEEPER_KEY=     # local fallback watcher key; used only with WATCHER=server
UNISWAP_API_KEY=  # developers.uniswap.org/dashboard
NOTIFY_TOKEN=     # required on a public server: the CRE workflow sends it to post messages
WATCHER=cre     # cre (default), server (local fallback), or off
